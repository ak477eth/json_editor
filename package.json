    "json",
    "json-editor",
    "json-viewer"
  ],
  "author": "Jules",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
