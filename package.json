{
  "name": "obsidian-json-editor",
  "version": "1.0.0",
  "description": "JSON viewer and editor plugin for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint ."
